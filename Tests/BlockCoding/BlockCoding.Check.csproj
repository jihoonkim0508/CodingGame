<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
    <!-- Unity assigns SerializeField fields through the Inspector. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <UnityEditorPath Condition="'$(UnityEditorPath)' == ''">C:/Program Files/Unity/Hub/Editor/6000.3.21f1/Editor</UnityEditorPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs" />
    <Compile Include="TreeCheck.cs" />
    <Compile Include="../../Assets/!_Project/Scripts/BlockCoding/*.cs" />
    <Reference Include="UnityEngine"><HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(UnityEditorPath)/Data/Managed/UnityEngine/UnityEngine.TextRenderingModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>../../Library/ScriptAssemblies/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>../../Library/ScriptAssemblies/Unity.TextMeshPro.dll</HintPath></Reference>
  </ItemGroup>
</Project>

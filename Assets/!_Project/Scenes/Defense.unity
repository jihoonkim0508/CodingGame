--- !u!114 &1241311428
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1241311427}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d4330563816ade544adb70393bc9de95, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodingGame.Defense.DefenseBlockHelp
  battle: {fileID: 420160337}
  window: {fileID: 1665560919}
  infoButtons:
  - {fileID: 1595459579}
  - {fileID: 997185551}
  closeButton: {fileID: 1144523879}
  title: {fileID: 1470805788}
  description: {fileID: 660531893}
  example: {fileID: 1183654382}
  stock: {fileID: 141759950}
  list: {fileID: 475603095}
  entries:
  - kind: 16
    button: {fileID: 1995540540}
    label: {fileID: 422083022}
    title: "for \xB7 \uD69F\uC218 \uBC18\uBCF5"
    description: "\uC815\uC218 n\uB9CC\uD07C \uC548\uCABD \uBA85\uB839\uC744 \uBC18\uBCF5\uD569\uB2C8\uB2E4.
      i\uB294 0\uBD80\uD130 n-1\uAE4C\uC9C0 \uBC14\uB01D\uB2C8\uB2E4.\n\n\uC22B\uC790
      \uBE14\uB85D\uC774 \uB0A8\uC544 \uC788\uC73C\uBA74 \uBC30\uCE58\uD560 \uB54C
      10\uC744 \uC790\uB3D9\uC73C\uB85C \uB123\uC2B5\uB2C8\uB2E4. \uC22B\uC790\uB97C
      \uD074\uB9AD\uD574 \uD69F\uC218\uB97C \uBC14\uAFB8\uC138\uC694.\n\uC785\uB825:
      \uC815\uC218 \uC22B\uC790 1\uAC1C \xB7 \uC548\uCABD: \uC2E4\uD589\uD560 \uBA85\uB839"
    example: "for i in range(10):\n    Attack()"
  - kind: 2
    button: {fileID: 1256806581}
    label: {fileID: 2034095239}
    title: "while \xB7 \uACC4\uC18D \uBC18\uBCF5"
    description: "\uC548\uCABD \uBA85\uB839\uC744 \uACC4\uC18D \uBC18\uBCF5\uD569\uB2C8\uB2E4.
      \uD604\uC7AC \uBE14\uB85D\uC740 while True \uD615\uC2DD\uC785\uB2C8\uB2E4.\n\n\uD0C8\uCD9C\uD558\uB824\uBA74
      if \uC548\uC5D0 break\uB97C \uB123\uC73C\uC138\uC694. continue\uB294 \uB0A8\uC740
      \uBA85\uB839\uC744 \uAC74\uB108\uB6F0\uACE0 \uB2E4\uC74C \uBC18\uBCF5\uC73C\uB85C
      \uC774\uB3D9\uD569\uB2C8\uB2E4.\n\uC785\uB825: \uC5C6\uC74C \xB7 \uC548\uCABD:
      \uC2E4\uD589\uD560 \uBA85\uB839"
    example: "while True:\n    Attack()\n    wait(1)"
  - kind: 3
    button: {fileID: 1582705698}
    label: {fileID: 1094863375}
    title: "if \xB7 \uC870\uAC74"
    description: "\uC870\uAC74\uC774 True\uC77C \uB54C\uB9CC \uC548\uCABD \uBA85\uB839\uC744
      \uC2E4\uD589\uD569\uB2C8\uB2E4.\n\n\uB9C8\uB984\uBAA8 \uC2AC\uB86F\uC5D0\uB294
      \uBE44\uAD50, True, False\uB97C \uB123\uC2B5\uB2C8\uB2E4. \uAC12 \uBE44\uAD50\uAC00
      \uD544\uC694\uD558\uBA74 \uBE44\uAD50 \uBE14\uB85D \uC548\uC5D0 \uC22B\uC790\uB098
      \uAC70\uB9AC \uAC12\uC744 \uB123\uC73C\uC138\uC694."
    example: "if 2 < 3:\n    Attack()"
  - kind: 4
    button: {fileID: 293882988}
    label: {fileID: 490168175}
    title: "elif \xB7 \uB2E4\uB978 \uC870\uAC74"
    description: "\uAC19\uC740 \uC601\uC5ED\uC758 if \uB610\uB294 elif \uBC14\uB85C
      \uC544\uB798\uC5D0 \uC5F0\uACB0\uD569\uB2C8\uB2E4. \uC55E\uC120 \uC870\uAC74\uC774
      \uBAA8\uB450 False\uC774\uACE0 \uC774 \uC870\uAC74\uC774 True\uC77C \uB54C
      \uC2E4\uD589\uD569\uB2C8\uB2E4."
    example: "if 3 < 2:\n    Attack()\nelif 2 < 3:\n    slash()"
  - kind: 5
    button: {fileID: 858101201}
    label: {fileID: 1925470796}
    title: "else \xB7 \uB098\uBA38\uC9C0 \uACBD\uC6B0"
    description: "if \uB610\uB294 elif \uBC14\uB85C \uC544\uB798\uC5D0 \uC5F0\uACB0\uD569\uB2C8\uB2E4.
      \uC55E\uC120 \uC870\uAC74\uC774 \uBAA8\uB450 False\uC77C \uB54C \uC2E4\uD589\uD569\uB2C8\uB2E4.
      \uC870\uAC74 \uC785\uB825\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
    example: "if 3 < 2:\n    Attack()\nelse:\n    wait(1)"
  - kind: 17
    button: {fileID: 826785543}
    label: {fileID: 1689862311}
    title: "break \xB7 \uBC18\uBCF5 \uC885\uB8CC"
    description: "for \uB610\uB294 while \uC548\uC5D0\uB9CC \uBC30\uCE58\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uBC18\uBCF5\uBB38\uC744
      \uC989\uC2DC \uB05D\uB0B4\uACE0 \uBC18\uBCF5\uBB38 \uB4A4 \uBA85\uB839\uC73C\uB85C
      \uC774\uB3D9\uD569\uB2C8\uB2E4."
    example: "while True:\n    Attack()\n    break"
  - kind: 18
    button: {fileID: 690819505}
    label: {fileID: 912171971}
    title: "continue \xB7 \uB2E4\uC74C \uBC18\uBCF5"
    description: "for \uB610\uB294 while \uC548\uC5D0\uB9CC \uBC30\uCE58\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uC774\uBC88 \uBC18\uBCF5\uC758 \uB0A8\uC740 \uBA85\uB839\uC744
      \uAC74\uB108\uB6F0\uACE0 \uB2E4\uC74C \uBC18\uBCF5\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    example: "for i in range(3):\n    if i == 1:\n        continue\n    Attack()"
  - kind: 22
    button: {fileID: 354947182}
    label: {fileID: 1773440419}
    title: attack(enemy)
    description: "enemy\uB97C \uC6D0\uAC70\uB9AC \uACF5\uACA9\uD569\uB2C8\uB2E4.
      \uC2E4\uC81C \uAC70\uB9AC\uC5D0 \uBC18\uBE44\uB840\uD574 \uD53C\uD574\uB97C
      \uC8FC\uBA70 1m \uC774\uB0B4\uC5D0\uC11C\uB294 \uCD5C\uB300 \uD53C\uD574\uB85C
      \uC81C\uD55C\uB429\uB2C8\uB2E4.\n\uBE48 \uB300\uC0C1 \uC2AC\uB86F\uC740 \uD568\uC218\uC758
      enemy\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uB2E4\uB978 \uC801 \uBCC0\uC218\uB85C
      \uAD50\uCCB4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD568\uC218\uB294 \uC6E8\uC774\uBE0C\uB9C8\uB2E4
      1\uBC88 \uC2E4\uD589\uB429\uB2C8\uB2E4. \uC5EC\uB7EC \uBC88 \uD558\uB824\uBA74
      for\xB7while\uB85C \uBC18\uBCF5\uD558\uC138\uC694."
    example: "def robot():\n    enemy = get_nearest_enemy()\n    attack(enemy)"
  - kind: 19
    button: {fileID: 2090866724}
    label: {fileID: 1362873834}
    title: slash()
    description: "\uB85C\uBD07\uC774 \uD55C \uBC14\uD034 \uB3CC\uBA70 \uC0AC\uAC70\uB9AC
      \uC548\uC758 \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uAC19\uC740 \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4(360\uB3C4).\n\uB300\uC0C1\uC744 \uB123\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uC0AC\uAC70\uB9AC \uC548\uC5D0 \uC801\uC774 \uC5C6\uC73C\uBA74 \uB4E4\uC5B4\uC62C
      \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB9BD\uB2C8\uB2E4.\n\uD568\uC218\uB294 \uC6E8\uC774\uBE0C\uB9C8\uB2E4
      1\uBC88 \uC2E4\uD589\uB429\uB2C8\uB2E4. \uC5EC\uB7EC \uBC88 \uD558\uB824\uBA74
      for\xB7while\uB85C \uBC18\uBCF5\uD558\uC138\uC694."
    example: "def robot():\n    for i in range(5):\n        slash()"
  - kind: 20
    button: {fileID: 2075488011}
    label: {fileID: 1564670811}
    title: block(enemy)
    description: "enemy\uC5D0\uAC8C \uD53C\uD574\uB97C \uC8FC\uACE0 \uC8FC\uBCC0
      \uC801\uC744 \uC7A0\uC2DC \uAE30\uC808\uC2DC\uD0B5\uB2C8\uB2E4.\n\uBE48 \uB300\uC0C1
      \uC2AC\uB86F\uC740 \uD568\uC218\uC758 enemy\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.
      \uB2E4\uB978 \uC801 \uBCC0\uC218\uB85C \uAD50\uCCB4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD568\uC218\uB294
      \uC6E8\uC774\uBE0C\uB9C8\uB2E4 1\uBC88 \uC2E4\uD589\uB429\uB2C8\uB2E4. \uC5EC\uB7EC
      \uBC88 \uD558\uB824\uBA74 for\xB7while\uB85C \uBC18\uBCF5\uD558\uC138\uC694."
    example: "def robot():\n    enemy = get_nearest_enemy()\n    block(enemy)"
  - kind: 21
    button: {fileID: 1476352315}
    label: {fileID: 1835596193}
    title: boom(enemy)
    description: "enemy\uC758 \uD604\uC7AC \uC704\uCE58\uC5D0 \uD3ED\uD0C4\uC744
      \uBC1C\uC0AC\uD574 \uC8FC\uBCC0 \uC801\uC5D0\uAC8C \uD3ED\uBC1C \uD53C\uD574\uB97C
      \uC90D\uB2C8\uB2E4.\n\uBE48 \uB300\uC0C1 \uC2AC\uB86F\uC740 \uD568\uC218\uC758
      enemy\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uB2E4\uB978 \uC801 \uBCC0\uC218\uB85C
      \uAD50\uCCB4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD568\uC218\uB294 \uC6E8\uC774\uBE0C\uB9C8\uB2E4
      1\uBC88 \uC2E4\uD589\uB429\uB2C8\uB2E4. \uC5EC\uB7EC \uBC88 \uD558\uB824\uBA74
      for\xB7while\uB85C \uBC18\uBCF5\uD558\uC138\uC694."
    example: "def robot():\n    enemy = get_nearest_enemy()\n    boom(enemy)"
  - kind: 23
    button: {fileID: 44338877}
    label: {fileID: 1372286865}
    title: slow(enemy)
    description: "enemy\uC5D0\uAC8C \uD53C\uD574\uC640 \uAC10\uC18D\uC744 \uC801\uC6A9\uD569\uB2C8\uB2E4.\n\uBE48
      \uB300\uC0C1 \uC2AC\uB86F\uC740 \uD568\uC218\uC758 enemy\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.
      \uB2E4\uB978 \uC801 \uBCC0\uC218\uB85C \uAD50\uCCB4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD568\uC218\uB294
      \uC6E8\uC774\uBE0C\uB9C8\uB2E4 1\uBC88 \uC2E4\uD589\uB429\uB2C8\uB2E4. \uC5EC\uB7EC
      \uBC88 \uD558\uB824\uBA74 for\xB7while\uB85C \uBC18\uBCF5\uD558\uC138\uC694."
    example: "def robot():\n    enemy = get_nearest_enemy()\n    slow(enemy)"
  - kind: 24
    button: {fileID: 1408051210}
    label: {fileID: 1485235369}
    title: "buff() \xB7 \uC544\uAD70 \uAC15\uD654"
    description: "Buffer\uC758 \uC804\uC6A9 \uD589\uB3D9\uC785\uB2C8\uB2E4. \uBC94\uC704
      \uC548\uC758 \uC544\uAD70\uC744 \uC77C\uC815 \uC2DC\uAC04 \uAC15\uD654\uD569\uB2C8\uB2E4.
      \uAC15\uD654\uB418\uB294 \uD53C\uD574\xB7\uC0AC\uAC70\uB9AC\xB7\uACF5\uACA9
      \uAC04\uACA9\uC740 \uB85C\uBD07 \uC124\uC815\uC5D0 \uB530\uB985\uB2C8\uB2E4.\n\nTank\uC5D0\uC11C\uB294
      \uD6A8\uACFC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    example: buff()
  - kind: 1
    button: {fileID: 1132599261}
    label: {fileID: 1185452450}
    title: "wait(seconds) \xB7 \uB300\uAE30"
    description: "\uC22B\uC790 \uC2AC\uB86F\uC5D0 \uB123\uC740 \uC2DC\uAC04\uB9CC\uD07C
      \uB85C\uBD07\uC758 \uCF54\uB4DC \uC2E4\uD589\uC744 \uAE30\uB2E4\uB9BD\uB2C8\uB2E4.
      \uB2E8\uC704\uB294 \uCD08\uC774\uBA70 0 \uC774\uC0C1\uC758 \uC18C\uC218\uB97C
      \uC4F8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    example: 'wait(0.5)

      Attack()'
  - kind: 10
    button: {fileID: 1264060185}
    label: {fileID: 1589163245}
    title: "\uC22B\uC790 \xB7 int / float"
    description: "\uC22B\uC790\uB97C \uD074\uB9AD\uD574 \uAC12\uC744 \uC785\uB825\uD569\uB2C8\uB2E4.
      3\uC740 \uC815\uC218, 0.5\uB294 \uC18C\uC218\uC785\uB2C8\uB2E4.\n\nfor \uD69F\uC218\uC5D0\uB294
      \uC815\uC218\uB97C, wait \uC2DC\uAC04\uC5D0\uB294 0 \uC774\uC0C1\uC758 \uC22B\uC790\uB97C
      \uC0AC\uC6A9\uD558\uC138\uC694."
    example: "for i in range(3):\n    wait(0.5)"
  - kind: 11
    button: {fileID: 887503160}
    label: {fileID: 1718444565}
    title: "\uBE44\uAD50 \xB7 \uC870\uAC74 \uB9CC\uB4E4\uAE30"
    description: "\uB450 \uAC12 \uC0AC\uC774\uC758 \uC5F0\uC0B0\uC790\uB97C \uACE0\uB985\uB2C8\uB2E4:
      <, >, <=, >=, ==.\n\n\uACB0\uACFC\uB294 True \uB610\uB294 False\uC785\uB2C8\uB2E4.
      \uB300\uC18C \uBE44\uAD50\uC5D0\uB294 \uC22B\uC790\uB97C \uB123\uC73C\uC138\uC694.
      if\uC640 elif \uC870\uAC74 \uC2AC\uB86F\uC5D0 \uC5F0\uACB0\uD569\uB2C8\uB2E4."
    example: "if 2 < 3:\n    Attack()"
  - kind: 12
    button: {fileID: 1646198137}
    label: {fileID: 365948797}
    title: "True \xB7 \uCC38"
    description: "\uD56D\uC0C1 \uCC38\uC778 \uC870\uAC74\uC785\uB2C8\uB2E4. if \uB610\uB294
      elif \uC870\uAC74 \uC2AC\uB86F\uC5D0 \uB123\uC73C\uBA74 \uD574\uB2F9 \uC870\uAC74\uC744
      \uB9CC\uC871\uD569\uB2C8\uB2E4."
    example: "if True:\n    Attack()"
  - kind: 13
    button: {fileID: 640585463}
    label: {fileID: 261192916}
    title: "False \xB7 \uAC70\uC9D3"
    description: "\uD56D\uC0C1 \uAC70\uC9D3\uC778 \uC870\uAC74\uC785\uB2C8\uB2E4.
      \uC870\uAC74 \uBD84\uAE30 \uC548\uC758 \uCF54\uB4DC\uB97C \uC7A0\uC2DC \uC2E4\uD589\uD558\uC9C0
      \uC54A\uC744 \uB54C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    example: "if False:\n    Attack()\nelse:\n    wait(1)"
  - kind: 14
    button: {fileID: 1188441622}
    label: {fileID: 1550710765}
    title: "\uBCC0\uC218 \uC120\uC5B8 \xB7 \uC774\uB984 = \uAC12"
    description: "\uBCC0\uC218 \uC774\uB984\uC744 \uC785\uB825\uD558\uACE0 \uAC12
      \uC2AC\uB86F\uC744 \uCC44\uC6CC \uC800\uC7A5\uD569\uB2C8\uB2E4. \uCC38\uC870\uD560
      \uB54C\uB294 variable \uBE14\uB85D\uC744 \uB193\uACE0 \uAC19\uC740 \uC774\uB984\uC744
      \uC785\uB825\uD558\uC138\uC694.\n\n\uC0AC\uC6A9 \uC804\uC5D0 \uC2E4\uD589\uB418\uB294
      \uBAA8\uB4E0 \uACBD\uB85C\uC5D0\uC11C \uC120\uC5B8\uD574\uC57C \uD569\uB2C8\uB2E4.
      \uC774\uB984\uC5D0 \uACF5\uBC31\uC744 \uB123\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    example: "enemy = get_nearest_enemy()\nif enemy.get_distance(get_pos_x(), get_pos_y())
      < 4:\n    Attack()"
  - kind: 15
    button: {fileID: 1933268393}
    label: {fileID: 749515873}
    title: "variable \xB7 \uBCC0\uC218 \uCC38\uC870"
    description: "\uAE30\uBCF8 \uC774\uB984\uC740 variable\uC785\uB2C8\uB2E4. \uC774\uB984\uC744
      \uC9C1\uC811 \uC785\uB825\uD574 \uC120\uC5B8\uD55C \uBCC0\uC218\uB098 for\uC758
      i\uB97C \uC0AC\uC6A9\uD558\uC138\uC694.\n\n\uC801 \uBCC0\uC218 \uC774\uB984
      \uB05D\uC5D0 .\uC744 \uBD99\uC774\uBA74 \uBA54\uC11C\uB4DC \uB4DC\uB86D\uB2E4\uC6B4\uC774
      \uB098\uD0C0\uB0A9\uB2C8\uB2E4. get_distance(x, y)\uB294 \uC22B\uC790\uB97C
      \uBC18\uD658\uD558\uBBC0\uB85C \uC6D0\uD615 \uAC12 \uBE14\uB85D\uC785\uB2C8\uB2E4.
      \uC810\uC744 \uC9C0\uC6B0\uBA74 \uAE30\uBCF8 \uBCC0\uC218 \uCC38\uC870\uB85C
      \uB3CC\uC544\uAC11\uB2C8\uB2E4."
    example: "enemy = get_nearest_enemy()\nif enemy.get_distance(get_pos_x(), get_pos_y())
      < 4:\n    Attack()"
  - kind: 6
    button: {fileID: 1962793866}
    label: {fileID: 1053959535}
    title: get_nearest_enemy()
    description: "\uB85C\uBD07\uC5D0\uC11C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC0B4\uC544
      \uC788\uB294 \uC801\uC744 \uBC18\uD658\uD569\uB2C8\uB2E4. \uBCC0\uC218\uC5D0
      \uC800\uC7A5\uD558\uACE0 get_distance(x, y)\uB85C \uAC70\uB9AC\uB97C \uBE44\uAD50\uD558\uC138\uC694.\n\n\uC801\uC774
      \uC5C6\uAC70\uB098 \uC0AC\uB77C\uC9C0\uBA74 \uAC70\uB9AC \uACC4\uC0B0\uC740
      \uBB34\uD55C\uB300\uB97C \uBC18\uD658\uD569\uB2C8\uB2E4."
    example: "enemy = get_nearest_enemy()\nif enemy.get_distance(get_pos_x(), get_pos_y())
      < 4:\n    Attack()"
  - kind: 7
    button: {fileID: 720286920}
    label: {fileID: 407373871}
    title: enemy.get_distance(x, y)
    description: "variable \uBE14\uB85D\uC5D0 \uC801 \uBCC0\uC218 \uC774\uB984\uACFC
      .\uC744 \uC785\uB825\uD55C \uB4A4 get_distance(\uB97C \uC120\uD0DD\uD558\uC138\uC694.
      x, y \uC2AC\uB86F\uC5D0\uB294 \uC88C\uD45C \uAC12\uC744 \uC5F0\uACB0\uD569\uB2C8\uB2E4.\n\n\uD574\uB2F9
      \uC801\uC774 \uC0AC\uB77C\uC9C0\uBA74 \uAC70\uB9AC\uB294 \uBB34\uD55C\uB300\uC785\uB2C8\uB2E4.
      \uC22B\uC790\uB97C \uBC18\uD658\uD558\uB294 \uC6D0\uD615 \uBE14\uB85D\uC785\uB2C8\uB2E4."
    example: "enemy = get_nearest_enemy()\nif enemy.get_distance(get_pos_x(), get_pos_y())
      < 4:\n    Attack()"
  - kind: 8
    button: {fileID: 1296098484}
    label: {fileID: 1649335521}
    title: get_pos_x()
    description: "\uD604\uC7AC \uB85C\uBD07\uC758 \uAC00\uB85C \uC88C\uD45C\uB97C
      \uC22B\uC790\uB85C \uBC18\uD658\uD569\uB2C8\uB2E4. \uAC70\uB9AC \uACC4\uC0B0\uC774\uB098
      \uBE44\uAD50\uC758 \uAC12 \uC2AC\uB86F\uC5D0 \uC5F0\uACB0\uD558\uC138\uC694."
    example: x = get_pos_x()
  - kind: 9
    button: {fileID: 1641223139}
    label: {fileID: 1493735133}
    title: get_pos_y()
    description: "\uD604\uC7AC \uB85C\uBD07\uC758 \uBC14\uB2E5\uBA74 \uC138\uB85C
      \uC88C\uD45C\uB97C \uC22B\uC790\uB85C \uBC18\uD658\uD569\uB2C8\uB2E4. \uB192\uC774\uAC00
      \uC544\uB2C8\uB77C \uB9F5 \uC704\uC758 \uC704\uCE58\uC785\uB2C8\uB2E4."
    example: y = get_pos_y()

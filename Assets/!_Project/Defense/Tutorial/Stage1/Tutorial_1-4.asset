    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uADF8\uB7F0\uB370 \uC544\uAE4C\uBD80\uD130 \uC791\uC5C5\uC2E4 \uAE4A\uC740
        \uACF3\uC5D0\uC11C\n\uC5C4\uCCAD \uD070 \uC624\uB958 \uC2E0\uD638\uAC00 \uC7A1\uD788\uACE0
        \uC788\uC5B4."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uC870\uC2EC\uD574. \uB2E4\uC74C \uC2F8\uC6C0\uC5D4 \uBCC0\uC218\uB3C4,
        \uC870\uAC74\uBB38\uB3C4\n\uC9C0\uAE08\uAE4C\uC9C0 \uBC30\uC6B4 \uAC78 \uBABD\uB545
        \uC368\uC57C \uD560 \uAC70\uC57C."
      focusKeys: []
      highlightKeys: []

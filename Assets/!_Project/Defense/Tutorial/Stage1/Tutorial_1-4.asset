    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uAC19\uC740 `if`\uB77C\uB3C4 \uBE44\uAD50\uD558\uB294 \uAC70\uB9AC\uB97C
        \uBC14\uAFB8\uBA74\n\uBCA0\uB294 \uC21C\uAC04\uB3C4 \uB2EC\uB77C\uC838. \uADF8
        \uC21C\uAC04\uC744 \uB124\uAC00 \uC815\uD55C \uAC70\uC57C."
      focusKeys: []
      highlightKeys: []
    targetKeys: []

  - stepId: A02
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uC774\uBC88\uC5D4 \uC624\uB958 \uCF54\uB4DC\uAC00 \uD6E8\uC52C \uB9CE\uC774
        \uBAB0\uB824\uC640!\n\uB85C\uBD07 \uD55C \uB300 \uD55C \uB300\uAC00 \uB611\uB611\uD558\uAC8C
        \uC2F8\uC6CC\uC57C \uD574."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uC9C0\uB09C\uBC88\uC5D0 \uBC30\uC6B4 <b>\uBC18\uBCF5\uBB38</b>, \uAE30\uC5B5\uB098\uC9C0?\n\uC774\uBC88\uC5D0\uB3C4
        \uBC18\uBCF5\uC73C\uB85C \uC2F8\uC6CC \uBCF4\uC790!"
      focusKeys: []
      highlightKeys: []
    targetKeys: []
    dim: 0
    undimmed: 0
    blockInput: 1
    outline: 1

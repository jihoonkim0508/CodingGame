  - stepId: A04
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uB9C9\uD788\uBA74 \uAC1C\uBC1C \uCC3D\uC758 <b>\u2018\uD78C\uD2B8\u2019</b>\uB97C
        \uB20C\uB7EC \uBD10.\n\uD574\uC57C \uD560 \uC77C\uC740 <b>\u2018\uBAA9\uD45C\u2019</b>
        \uCE78\uC5D0 \uC801\uC5B4 \uB458\uAC8C."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uB2E4 \uB410\uC73C\uBA74 <b>\u2018\uC804\uD22C \uC2DC\uC791\u2019</b>!\n\uC774\uBC88
        \uBB34\uB9AC\uB294 \uB124 \uC870\uAC74\uBB38\uC5D0 \uB9E1\uAE38\uAC8C!"
      focusKeys: []
      highlightKeys: []
    targetKeys: []

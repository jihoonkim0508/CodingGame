  - stepId: A03
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uC0C8 <b>\uC804\uC0AC\uD615</b> \uB85C\uBD07\uB3C4 \uD55C \uB300 \uB354
        \uBC1B\uC558\uC5B4.\n\uC774\uBC88\uC5D4 \uC774 \uC870\uAC74\uBB38\uC744 \uAC00\uC9C4
        \uB85C\uBD07\uC774 <b>\uB450 \uB300</b> \uD544\uC694\uD574."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uC9C0\uB09C\uBC88\uC5D0 `if`\uB97C \uB123\uC740 \uB85C\uBD07\uC774
        \uD55C \uB300 \uC788\uC9C0?\n\uD55C \uB300 \uB354, \uAC70\uB9AC\uB97C \uC7AC\uC11C
        \uBCA0\uB294 `if` \uBA85\uB839\uC744 \uB123\uC5B4 \uC918."
      focusKeys: []
      highlightKeys: []
    - textId: t3
      speaker: "\uB514\uBC84"
      text: "\uC624\uB958 \uCF54\uB4DC\uAC00 \uC6B0\uB974\uB974 \uBAA8\uC600\uC744
        \uB54C \uBCA0\uBA74\n\uD55C \uBC88\uC5D0 \uC5EC\uB7EC \uB9C8\uB9AC\uB97C
        \uBCA8 \uC218\uB3C4 \uC788\uC5B4!"
      focusKeys: []
      highlightKeys: []
    targetKeys: []
    dim: 0
    undimmed: 0
    blockInput: 1

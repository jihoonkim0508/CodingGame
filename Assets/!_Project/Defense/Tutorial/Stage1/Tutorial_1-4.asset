  - stepId: A03
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uC0C8 <b>\uC6D0\uAC70\uB9AC</b> \uB85C\uBD07\uB3C4 \uD55C \uB300 \uB354
        \uBC1B\uC558\uC5B4.\n\uAE38 \uC606\uC5D0 \uC138\uC6B0\uACE0 <b>\u2018\uAC1C\uBC1C\u2019</b>\uC5D0\uC11C
        \uBA85\uB839\uC744 \uB123\uC5B4 \uC918."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uC6D0\uAC70\uB9AC \uB85C\uBD07\uC740 <b>`attack()`</b>\uC73C\uB85C
        \uC3F4. \uAD04\uD638 \uC548\uC5D0\n<b>`get_nearest_enemy()`</b>\uB97C \uB123\uC73C\uBA74
        \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC744 \uC3D8\uC9C0!"
      focusKeys: []
      highlightKeys: []
    - textId: t3
      speaker: "\uB514\uBC84"
      text: "\uBC18\uBCF5 \uC548\uC5D0 \uB123\uC73C\uBA74 \uC5EC\uB7EC \uBC88 \uC3E0
        \uC218 \uC788\uC5B4.\n\uC900\uBE44\uAC00 \uB2E4 \uC548 \uB3FC\uB3C4 \uC804\uD22C\uB294
        \uC5B8\uC81C\uB4E0 \uC2DC\uC791\uD560 \uC218 \uC788\uC5B4!"
      focusKeys: []
      highlightKeys: []
    targetKeys: []

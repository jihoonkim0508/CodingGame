  - stepId: B01
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uD574\uB0C8\uB2E4! \uADF8 \uB9CE\uC740 \uBB34\uB9AC\uB97C \uB05D\uAE4C\uC9C0
        \uBC84\uD168 \uB0C8\uC5B4!"
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uC870\uAC74\uC774 \uCC38\uC77C \uB54C\uB9CC \uBCA0\uAC8C \uB9CC\uB4E0
        \uB355\uBD84\uC774\uC57C.\n\uB85C\uBD07\uB9C8\uB2E4 \uC2A4\uC2A4\uB85C \uBCA8
        \uB54C\uB97C \uACE8\uB790\uC796\uC544."
      focusKeys: []
      highlightKeys: []
    targetKeys: []

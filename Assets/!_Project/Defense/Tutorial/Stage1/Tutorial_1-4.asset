  - stepId: A02
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uC774\uBC88\uC5D4 \uC624\uB958 \uCF54\uB4DC\uAC00 \uD6E8\uC52C \uB9CE\uC774
        \uBAB0\uB824\uC640!\n\uB85C\uBD07 \uD55C \uB300 \uD55C \uB300\uAC00 \uB611\uB611\uD558\uAC8C
        \uC2F8\uC6CC\uC57C \uD574."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uC9C0\uB09C\uBC88\uC5D0 \uB9CC\uB4E0 `if`, \uAE30\uC5B5\uB098\uC9C0?\n<b>\uC801\uC774
        \uB0B4 \uC0AC\uAC70\uB9AC \uC548\uC5D0 \uC624\uBA74, \uBCA4\uB2E4!</b>"
      focusKeys: []
      highlightKeys: []
    targetKeys: []
    dim: 0
    undimmed: 0
    blockInput: 1
    outline: 1
    completionMode: 0
    completionSignal: 

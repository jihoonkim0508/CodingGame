    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uC774\uBC88 \uC6E8\uC774\uBE0C\uB3C4 \uB05D\uB0AC\uC5B4! \uD63C\uC790\uC11C\uB3C4
        \uD574\uB0C8\uB124!"
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uBD24\uC9C0? \uBC18\uBCF5 \uC548\uC5D0 \uBCA0\uAE30\uB97C \uB123\uC5B4
        \uB450\uBA74\n\uB85C\uBD07\uC740 \uC801\uC774 \uC62C \uB54C\uB9C8\uB2E4 \uBA87
        \uBC88\uC774\uACE0 \uBCA0\uC5B4."
      focusKeys: []
      highlightKeys: []
    targetKeys: []

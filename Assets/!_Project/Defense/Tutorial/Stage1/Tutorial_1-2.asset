    - textId: t1
      speaker: "\uC548\uB0B4\uC790"
      text: "\ubcc0\uc218 \uc774\ub984\uc740 \ub9c8\uc74c\ub300\ub85c \uc815\ud574\ub3c4 \ub3fc. <b>\uc800\uc7a5\ud55c \uc774\ub984\uacfc \uacf5\uaca9\ud560 \ub54c \uc4f0\ub294 \uc774\ub984</b>\uc744 \ub9de\ucdb0 \uc918!\n\ub9c9\ud788\uba74 \uac1c\ubc1c\ucc3d\uc758 \u2018\ud78c\ud2b8\u2019\ub97c \ubcf4\uace0, \uc900\ube44\ub418\uba74 \ub2eb\uace0 \u2018\uc804\ud22c \uc2dc\uc791\u2019\uc744 \ub20c\ub7ec \ubd10."
      focusKeys: []

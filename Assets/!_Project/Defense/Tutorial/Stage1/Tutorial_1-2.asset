  steps:
  - stepId: A01
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uC800\uAE30 \uBD10, \uC624\uB958 \uCF54\uB4DC\uB4E4\uC774 \uB610 \uBAB0\uB824\uC624\uACE0
        \uC788\uC5B4!\n\uC774\uBC88\uC5D4 \uB124\uAC00 \uC9C1\uC811 \uB9C9\uC544
        \uBCFC \uCC28\uB840\uC57C."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uAC71\uC815 \uB9C8, \uC544\uAE4C \uD55C \uADF8\uB300\uB85C \uD558\uBA74
        \uB3FC.\n<b>\uBC18\uBCF5\uBB38 \uC548\uC5D0 \uBCA0\uAE30!</b>"
      focusKeys: []
      highlightKeys: []
    targetKeys: []
    dim: 0
    undimmed: 0
    blockInput: 1
    outline: 1
    completionMode: 0

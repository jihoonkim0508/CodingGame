  - stepId: A02
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uC0C8 <b>\uC804\uC0AC\uD615</b> \uB85C\uBD07\uC774\uB791 \uBE14\uB85D\uB3C4
        \uB354 \uBC1B\uC558\uC5B4.\n\uC544\uB798 \uC804\uC0AC\uD615 \uBC84\uD2BC\uC744
        \uB20C\uB7EC \uAE38 \uC606\uC5D0 \uD55C \uB300 \uB354 \uC138\uC6CC \uC918."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uC0C8 \uB85C\uBD07\uC740 \uC544\uC9C1 \uBA38\uB9BF\uC18D\uC774 \uD145
        \uBE44\uC5B4 \uC788\uC5B4.\n\uB85C\uBD07\uC744 \uB204\uB974\uACE0 <b>\u2018\uAC1C\uBC1C\u2019</b>\uC5D0\uC11C
        \uBA85\uB839\uC744 \uB123\uC5B4 \uC918."
      focusKeys: []
      highlightKeys: []
    - textId: t3
      speaker: "\uB514\uBC84"
      text: "\uBA3C\uC800 \uC138\uC6B4 \uB85C\uBD07\uC740 \uC544\uAE4C \uB9CC\uB4E0
        \uBA85\uB839\uC744\n\uADF8\uB300\uB85C \uAE30\uC5B5\uD558\uACE0 \uC788\uC73C\uB2C8\uAE4C
        \uC548\uC2EC\uD574!"
      focusKeys: []
      highlightKeys: []
    targetKeys: []
    dim: 0
    undimmed: 0
    blockInput: 1
    outline: 1
    completionMode: 0

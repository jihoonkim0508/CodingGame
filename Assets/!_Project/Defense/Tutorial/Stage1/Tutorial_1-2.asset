  - stepId: A03
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uCC38, \uBC18\uBCF5 \uD69F\uC218\uB294 10\uC774 \uC544\uB2C8\uC5B4\uB3C4
        \uB3FC.\n\uC22B\uC790 \uCE78\uC744 \uB20C\uB7EC\uC11C <b>\uC6D0\uD558\uB294
        \uB9CC\uD07C</b> \uBC14\uAFD4 \uBD10!"
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uB9C9\uD788\uBA74 \uAC1C\uBC1C \uCC3D\uC758 <b>\u2018\uD78C\uD2B8\u2019</b>\uB97C
        \uB20C\uB7EC \uBD10.\n\uD574\uC57C \uD560 \uC77C\uC740 <b>\u2018\uBAA9\uD45C\u2019</b>
        \uCE78\uC5D0 \uC801\uC5B4 \uB458\uAC8C."
      focusKeys: []
      highlightKeys: []
    - textId: t3
      speaker: "\uB514\uBC84"
      text: "\uB2E4 \uB410\uC73C\uBA74 \uAC1C\uBC1C \uCC3D\uC744 \uB2EB\uACE0 <b>\u2018\uC804\uD22C
        \uC2DC\uC791\u2019</b>!\n\uC774\uBC88\uC5D4 \uB124 \uC19C\uC528\uB97C \uBBFF\uC5B4
        \uBCFC\uAC8C!"
      focusKeys: []
      highlightKeys: []
    targetKeys: []

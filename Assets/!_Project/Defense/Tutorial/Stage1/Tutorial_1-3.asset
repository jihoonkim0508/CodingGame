      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uC801\uC774 \uC6D0 \uC548\uC774\uBA74 \uCC38, \uC544\uC9C1 \uBA40\uBA74
        \uAC70\uC9D3.\n\uB85C\uBD07\uC740 \uCC38\uC77C \uB54C\uB9CC \uCE7C\uC744
        \uD718\uB450\uB974\uAC8C \uB420 \uAC70\uC57C."
      focusKeys: []
      highlightKeys: []
    targetKeys: []

    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uBA3C\uC800 <b>\uC624\uB958 \uCF54\uB4DC\uAC00 \uB098\uC624\uB294 \uACF3\uC5D0\uC11C
        \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uB85C\uBD07</b>\uC744 \uB20C\uB7EC \uC918.\n\uD654\uC0B4\uD45C\uAC00
        \uAC00\uB9AC\uD0A4\uB294 \uB85C\uBD07\uC774\uC57C!"
      focusKeys: []
      highlightKeys: []
    targetKeys:
    - Robot.Unit.0

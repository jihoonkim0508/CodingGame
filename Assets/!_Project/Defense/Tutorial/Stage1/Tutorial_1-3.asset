    texts:
    - textId: t1
      speaker: "\uC548\uB0B4\uC790"
      text: "\uBA3C\uC800 \uC870\uAC74\uC774 \uC5C6\uB294 \uAE30\uC874 \uBCA0\uAE30\uB97C
        \uC67C\uCABD\uC5D0\uC11C \uBCF4\uC790.\n\uC0AC\uAC70\uB9AC \uB05D\uC5D0 \uC628
        <b>\uC55E\uC758 \uC801\uC744 \uBA3C\uC800 \uBCA0\uACE0</b>, \uB4A4\uB530\uB974\uB294

  - stepId: A02
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uB85C\uBD07\uC5D0\uAC8C\uB3C4 \uC870\uAC74\uC744 \uC904 \uC218 \uC788\uC5B4.\n<b>\uC801\uC774
        \uB0B4 \uCE7C\uC774 \uB2FF\uB294 \uAC70\uB9AC \uC548\uC5D0 \uB4E4\uC5B4\uC624\uBA74,
        \uBCA0\uAE30!</b>"
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uADF8\uB7EC\uB824\uBA74 \uB85C\uBD07\uC774 \uC801\uAE4C\uC9C0\uC758
        \uAC70\uB9AC\uB97C \uC7AC\uACE0\n\uB0B4 \uACF5\uACA9 \uC0AC\uAC70\uB9AC\uC640
        \uBE44\uAD50\uD574\uC57C \uD574. \uAC19\uC774 \uB9CC\uB4E4\uC5B4 \uBCF4\uC790!"
      focusKeys: []
      highlightKeys: []
    targetKeys: []

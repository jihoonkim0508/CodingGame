  - stepId: B01
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uBD24\uC9C0? \uC774\uBC88\uC5D4 \uCF54\uB4DC\uB97C \uC0B4\uC9DD \uBC14\uAFD4
        \uB1A8\uC5B4.\n\uBC18\uBCF5 \uC548\uC758 \uBCA0\uAE30\uB294 \uC7A0\uC2DC
        \uBE7C\uACE0, \uC0C8 \uC904 \uB450 \uAC1C\uB97C \uB123\uC5C8\uC9C0."
      focusKeys:
      - Editor.Code.Line.1/1
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uBC18\uBCF5 \uC548 \uCCAB\uC9F8 \uC904\uC740 <b>\uAC00\uC7A5 \uAC00\uAE4C\uC6B4
        \uC801</b>\uC744 \uCC3E\uC544\uC11C\n`enemy`\uB77C\uB294 <b>\uC0C1\uC790</b>\uC5D0
        \uB2F4\uC544."
      focusKeys:
      - Editor.Code.Line.1/1
      highlightKeys: []
    - textId: t3
      speaker: "\uB514\uBC84"
      text: "\uC774\uB807\uAC8C \uC774\uB984 \uBD99\uC778 \uC0C1\uC790\uC5D0 \uAC12\uC744
        \uB2F4\uC544 \uB450\uACE0\n\uD544\uC694\uD560 \uB54C \uAEBC\uB0B4 \uC4F0\uB294
        \uAC78 <b>\uBCC0\uC218</b>\uB77C\uACE0 \uD574."
      focusKeys:
      - Editor.Code.Line.1/1
      highlightKeys: []
    targetKeys: []

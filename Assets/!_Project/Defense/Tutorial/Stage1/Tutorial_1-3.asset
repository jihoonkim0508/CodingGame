      speaker: "\uC548\uB0B4\uC790"
      text: "<b>\u2018\uBE44\uAC00 \uC624\uBA74 \uC6B0\uC0B0\uC744 \uC4F4\uB2E4\u2019</b>\uCC98\uB7FC,

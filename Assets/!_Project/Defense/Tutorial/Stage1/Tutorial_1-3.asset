    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uB458\uC9F8 \uC904\uC740 <b>\uC801\uACFC \uC774 \uB85C\uBD07 \uC0AC\uC774\uC758
        \uAC70\uB9AC</b>\uB97C \uC7AC\uC11C\n`enemy_distance`\uB77C\uB294 \uC0C1\uC790\uC5D0
        \uB2F4\uC544."
      focusKeys:
      - Editor.Code.Line.1/2
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uC774\uB984\uC774 \uC880 \uAE38\uC9C0? \uADF8\uB0E5\n<b>\u2018\uC801\uAE4C\uC9C0\uC758
        \uAC70\uB9AC\u2019</b>\uB77C\uACE0 \uC77D\uC73C\uBA74 \uB3FC!"

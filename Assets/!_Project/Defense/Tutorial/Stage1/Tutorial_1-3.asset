  steps:
  - stepId: A01
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uC624\uB958 \uCF54\uB4DC\uB4E4\uC774 \uB610 \uC628\uB2E4! \uC774\uBC88\uC5D4\n\uC6B0\uB9AC
        \uB85C\uBD07\uC744 \uC870\uAE08 \uB354 \uB611\uB611\uD558\uAC8C \uB9CC\uB4E4\uC5B4
        \uBCF4\uC790."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uC6B0\uB9AC\uB3C4 <b>\u2018\uBE44\uAC00 \uC624\uBA74 \uC6B0\uC0B0\uC744
        \uC4F4\uB2E4\u2019</b>\uCC98\uB7FC\n\uC5B4\uB5A4 \uB54C\uC5D0\uB9CC \uD558\uB294
        \uD589\uB3D9\uC774 \uC788\uC796\uC544?"
      focusKeys: []
      highlightKeys: []
    - textId: t3
      speaker: "\uB514\uBC84"
      text: "\uC5EC\uAE30\uC11C \u2018\uBE44\uAC00 \uC624\uBA74\u2019\uC774 <b>\uC870\uAC74</b>\uC774\uC57C.\n\uC870\uAC74\uC774
        \uB9DE\uC744 \uB54C\uB9CC \u2018\uC6B0\uC0B0 \uC4F0\uAE30\u2019\uB97C \uD558\uB294
        \uAC70\uC9C0."
      focusKeys: []
      highlightKeys: []
    targetKeys: []
    dim: 0
    undimmed: 0
    blockInput: 1
    outline: 1
    completionMode: 0

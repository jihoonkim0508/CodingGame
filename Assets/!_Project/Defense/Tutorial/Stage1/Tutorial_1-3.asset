      text: "\uB85C\uBD07\uC740 \uC6D0\uB798 \uACF5\uACA9\uC774 \uB2FF\uB294 \uAC70\uB9AC\uC5D0\uC11C\uB9CC
        \uBCA0\uC5B4.\n\uC774\uBC88\uC5D4 \uC870\uAC74\uBB38\uC73C\uB85C <b>\uC870\uAE08
        \uB354 \uAE30\uB2E4\uB838\uB2E4\uAC00, \uC801 \uB458\uC774 \uAC00\uAE4C\uC6CC\uC84C\uC744

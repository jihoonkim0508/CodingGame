  - stepId: A02
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uAC70\uB300\uD55C \uC624\uB958 \uCF54\uB4DC\uB77C\uB2C8?!\n\uC544\uAE4C
        \uC7A1\uD788\uB358 \uADF8 \uC2E0\uD638\uAC00 \uC774 \uB140\uC11D\uC774\uC5C8\uAD6C\uB098!"
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uADF8\uB7F0\uB370 \uD070 \uB140\uC11D\uC740 \uBC14\uB85C \uC624\uC9C0
        \uC54A\uC544.\n\uC791\uC740 \uC624\uB958 \uCF54\uB4DC\uB4E4\uC774 \uBA3C\uC800
        \uC55E\uC7A5\uC11C\uC11C \uC640."
      focusKeys: []
      highlightKeys: []
    - textId: t3
      speaker: "\uB514\uBC84"
      text: "\uC791\uC740 \uB140\uC11D\uC774 <b>\uD55C \uB9C8\uB9AC\uB77C\uB3C4 \uCF54\uC5B4\uC5D0
        \uB2FF\uC73C\uBA74</b>\n\uBC29\uC5B4 \uC2E4\uD328\uC57C. \uD558\uB098\uB3C4
        \uB193\uCE58\uBA74 \uC548 \uB3FC!"
      focusKeys: []
      highlightKeys: []
    targetKeys: []
    dim: 0
    undimmed: 0
    blockInput: 1

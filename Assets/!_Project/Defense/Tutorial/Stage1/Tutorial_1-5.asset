  - stepId: A04
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uC0C8\uB85C \uBC1B\uC740 \uBE14\uB85D\uC73C\uB85C \uBC18\uBCF5\uC744
        \uB354 \uAE38\uAC8C \uC9DC \uBD10.\n\uD568\uC218\uAC00 \uB05D\uB098\uBA74
        <b>\u2018\uC2E4\uD589\u2019</b>\uC73C\uB85C \uB2E4\uC2DC \uBD80\uB974\uB294
        \uAC83\uB3C4 \uC78A\uC9C0 \uB9C8!"
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uB9C9\uD788\uBA74 <b>\u2018\uD78C\uD2B8\u2019</b>, \uD560 \uC77C\uC740
        <b>\u2018\uBAA9\uD45C\u2019</b> \uCE78\uC5D0 \uC788\uC5B4.\n\uC900\uBE44\uB418\uBA74
        <b>\u2018\uC804\uD22C \uC2DC\uC791\u2019</b>! \uC774 \uC791\uC5C5\uC2E4\uC744
        \uAF2D \uC9C0\uCF1C \uB0B4\uC790!"
      focusKeys: []
      highlightKeys: []
    targetKeys: []

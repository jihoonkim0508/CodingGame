    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uD574\uB0C8\uB2E4! \uC791\uC740 \uB140\uC11D\uB4E4\uB3C4, \uBCF4\uC2A4\uAE4C\uC9C0\uB3C4

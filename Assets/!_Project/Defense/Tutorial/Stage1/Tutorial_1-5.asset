  - stepId: A03
    kind: 0
    dialoguePosition: 0
    texts:
    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uC791\uC740 \uB140\uC11D\uB4E4\uC744 \uBAA8\uB450 \uC4F0\uB7EC\uB728\uB9AC\uBA74\n\uADF8\uB54C
        \uD070 \uB140\uC11D, <b>\uBCF4\uC2A4</b>\uAC00 \uB098\uD0C0\uB098."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uBCF4\uC2A4\uB294 \uCF54\uC5B4\uC5D0 \uB2FF\uAE30\uB9CC \uD574\uB3C4
        \uCF54\uC5B4\uAC00 \uBB34\uB108\uC838.\n\uC2DC\uAC04 \uC548\uC5D0 \uAF2D
        \uC4F0\uB7EC\uB728\uB824\uC57C \uD574!"
      focusKeys: []
      highlightKeys: []
    targetKeys: []
    dim: 0
    undimmed: 0

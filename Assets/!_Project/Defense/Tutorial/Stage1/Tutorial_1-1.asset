    - textId: t1
      speaker: "\uB514\uBC84"
      text: "\uAC70\uAE30 \uB108! \uB0B4 \uBAA9\uC18C\uB9AC \uB4E4\uB9AC\uC9C0?!\n\uB098\uB294
        \uC774 \uC791\uC5C5\uC2E4\uC744 \uC9C0\uD0A4\uB294 \uB514\uBC84\uAE45 \uB85C\uBD07,
        <b>\uB514\uBC84</b>\uC57C."
      focusKeys: []
      highlightKeys: []
    - textId: t2
      speaker: "\uB514\uBC84"
      text: "\uB098 \uD63C\uC790\uC11C\uB294 \uC800 \uB140\uC11D\uB4E4\uC744 \uBABB
        \uB9C9\uC544. \uB098 \uC880 \uB3C4\uC640\uC918!\n\uCF54\uB529\uC774 \uCC98\uC74C\uC774\uC5B4\uB3C4
        \uAD1C\uCC2E\uC544. \uB0B4\uAC00 \uD558\uB098\uC529 \uC54C\uB824 \uC904\uAC8C."
      focusKeys: []
